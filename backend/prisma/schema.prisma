generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("roles")
}

model User {
  id                   String              @id @default(uuid()) @db.Char(36)
  roleId               String              @map("role_id") @db.Char(36)
  email                String              @unique @db.VarChar(150)
  password             String              @db.VarChar(255)
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  deletedBy            String?             @map("deleted_by") @db.Char(36)
  auditLogs            AuditLog[]
  caseAssignments      CaseAssignment[]
  statusHistory        CaseStatusHistory[]
  custodyEventsActor   CustodyEvent[]      @relation("Actor")
  custodyEventsRecip   CustodyEvent[]      @relation("Recipient")
  evidenceApprovalsApp EvidenceApproval[]  @relation("ApprovedBy")
  evidenceApprovalsReq EvidenceApproval[]  @relation("RequestedBy")
  mfaSecret            MFASecret?
  otpVerifications     OTPVerification[]
  policeProfile        PoliceProfile?
  reportExports        ReportExport[]
  reports              Report[]
  systemLogs           SystemLog[]
  courtPresentationsPresented CourtPresentation[] @relation("PresentedBy")
  courtPresentationsReturned CourtPresentation[] @relation("ReturnedBy")
  deletedByUser        User?               @relation("DeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)
  deletedUsers         User[]              @relation("DeletedBy")
  role                 Role                @relation(fields: [roleId], references: [id])

  @@index([deletedAt, isActive])
  @@index([email])
  @@index([roleId])
  @@index([deletedBy], map: "users_deleted_by_fkey")
  @@map("users")
}

model PoliceProfile {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  policeId  String   @unique @map("police_id") @db.VarChar(30)
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("police_profiles")
}

model OTPVerification {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  otpCode   String   @map("otp_code") @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "otp_verifications_user_id_fkey")
  @@map("otp_verifications")
}

model MFASecret {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  secret    String   @db.VarChar(255)
  isEnabled Boolean  @default(false) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("mfa_secrets")
}

model Case {
  id            String              @id @default(uuid()) @db.Char(36)
  caseNumber    String              @unique @map("case_number") @db.VarChar(100)
  title         String              @db.VarChar(255)
  description   String?             @db.Text
  status        CaseStatus
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")
  assignments   CaseAssignment[]
  statusHistory CaseStatusHistory[]
  evidences     Evidence[]
  reports       Report[]

  @@index([status])
  @@index([deletedAt])
  @@map("cases")
}

model CaseAssignment {
  id         String   @id @default(uuid()) @db.Char(36)
  caseId     String   @map("case_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  assignedAt DateTime @map("assigned_at")
  case       Case     @relation(fields: [caseId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([caseId, userId])
  @@index([userId], map: "case_assignments_user_id_fkey")
  @@map("case_assignments")
}

model CaseStatusHistory {
  id        String     @id @default(uuid()) @db.Char(36)
  caseId    String     @map("case_id") @db.Char(36)
  status    CaseStatus
  changedBy String     @map("changed_by") @db.Char(36)
  changedAt DateTime   @map("changed_at")
  case      Case       @relation(fields: [caseId], references: [id])
  user      User       @relation(fields: [changedBy], references: [id])

  @@index([caseId], map: "case_status_history_case_id_fkey")
  @@index([changedBy], map: "case_status_history_changed_by_fkey")
  @@map("case_status_history")
}

model Evidence {
  id                 String             @id @default(uuid()) @db.Char(36)
  caseId             String             @map("case_id") @db.Char(36)
  parentId           String?            @map("parent_id") @db.Char(36)
  description        String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  category           EvidenceCategory
  collectionDate     DateTime           @map("collection_date")
  collectionLocation String             @map("collection_location") @db.Text
  evidenceNumber     String             @unique @map("evidence_number") @db.VarChar(100)
  isReadyForTransfer Boolean            @default(false) @map("is_ready_for_transfer")
  status             EvidenceStatus     @default(SEIZED)
  storageLocation    String?            @map("storage_location") @db.Text
  
  // Legal Authority
  warrantNumber      String?            @map("warrant_number") @db.VarChar(100)
  consentReference   String?            @map("consent_reference") @db.VarChar(100)
  seizureAuth        String?            @map("seizure_auth") @db.VarChar(100)
  legalBasis         String?            @map("legal_basis") @db.VarChar(100)

  // Physical Storage Tracking
  storageBuilding    String?            @map("storage_building") @db.VarChar(100)
  storageRoom        String?            @map("storage_room") @db.VarChar(100)
  storageCabinet     String?            @map("storage_cabinet") @db.VarChar(100)
  storageShelf       String?            @map("storage_shelf") @db.VarChar(100)
  storageLocker      String?            @map("storage_locker") @db.VarChar(100)

  title              String             @db.Text
  
  parent             Evidence?          @relation("EvidenceHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Evidence[]         @relation("EvidenceHierarchy")
  
  attachments        Attachment[]
  custodyEvents      CustodyEvent[]
  approvals          EvidenceApproval[]
  hashes             EvidenceHash[]
  case               Case               @relation(fields: [caseId], references: [id])
  qrCode             QRCode?
  courtPresentations CourtPresentation[]

  @@index([caseId], map: "evidences_case_id_fkey")
  @@index([parentId], map: "evidences_parent_id_fkey")
  @@map("evidences")
}

model EvidenceApproval {
  id             String             @id @default(uuid()) @db.Char(36)
  evidenceId     String             @map("evidence_id") @db.Char(36)
  requestedBy    String             @map("requested_by") @db.Char(36)
  approvedBy     String?            @map("approved_by") @db.Char(36)
  status         ApprovalStatus
  actionType     ApprovalActionType @map("action_type")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  proposedData   String?            @map("proposed_data") @db.LongText
  approvingUser  User?              @relation("ApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  evidence       Evidence           @relation(fields: [evidenceId], references: [id])
  requestingUser User               @relation("RequestedBy", fields: [requestedBy], references: [id])

  @@index([approvedBy], map: "evidence_approvals_approved_by_fkey")
  @@index([evidenceId], map: "evidence_approvals_evidence_id_fkey")
  @@index([requestedBy], map: "evidence_approvals_requested_by_fkey")
  @@map("evidence_approvals")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Char(36)
  evidenceId String   @map("evidence_id") @db.Char(36)
  filePath   String   @map("file_path") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  fileName   String   @map("file_name") @db.VarChar(255)
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  evidence   Evidence @relation(fields: [evidenceId], references: [id])

  @@index([evidenceId], map: "attachments_evidence_id_fkey")
  @@map("attachments")
}

model EvidenceHash {
  id          String   @id @default(uuid()) @db.Char(36)
  evidenceId  String   @map("evidence_id") @db.Char(36)
  hashValue   String   @map("hash_value") @db.VarChar(64)
  generatedAt DateTime @map("generated_at")
  evidence    Evidence @relation(fields: [evidenceId], references: [id])

  @@index([evidenceId], map: "evidence_hashes_evidence_id_fkey")
  @@map("evidence_hashes")
}

model QRCode {
  id         String   @id @default(uuid()) @db.Char(36)
  evidenceId String   @unique @map("evidence_id") @db.Char(36)
  qrPayload  String   @map("qr_payload") @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  evidence   Evidence @relation(fields: [evidenceId], references: [id])

  @@map("qr_codes")
}

model CustodyEvent {
  id                    String        @id @default(uuid()) @db.Char(36)
  evidenceId            String        @map("evidence_id") @db.Char(36)
  action                CustodyAction
  actorId               String        @map("actor_id") @db.Char(36)
  recipientId           String?       @map("recipient_id") @db.Char(36)
  location              String        @db.Text
  eventTime             DateTime      @map("event_time")
  notes                 String?       @db.Text
  isOverdue             Boolean       @default(false) @map("is_overdue")
  
  // External Transfer Fields
  externalOrganization  String?       @map("external_organization") @db.VarChar(200)
  externalRecipientName String?       @map("external_recipient_name") @db.VarChar(150)
  signatureName         String?       @map("signature_name") @db.VarChar(150)
  transferReason        String?       @map("transfer_reason") @db.VarChar(255)

  actor                 User          @relation("Actor", fields: [actorId], references: [id])
  evidence              Evidence      @relation(fields: [evidenceId], references: [id])
  recipient             User?         @relation("Recipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([actorId], map: "custody_events_actor_id_fkey")
  @@index([evidenceId], map: "custody_events_evidence_id_fkey")
  @@index([recipientId], map: "custody_events_recipient_id_fkey")
  @@map("custody_events")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  action      String   @db.VarChar(255)
  entityId    String?  @map("entity_id") @db.Char(36)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  timestamp    DateTime @default(now())
  description  String?  @db.Text
  previousHash String?  @map("previous_hash") @db.VarChar(255)
  newHash      String?  @map("new_hash") @db.VarChar(255)
  signature    String?  @db.VarChar(255)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}

model SystemLog {
  id        String   @id @default(uuid()) @db.Char(36)
  level     String   @db.VarChar(20)
  message   String   @db.Text
  userId    String?  @map("user_id") @db.Char(36)
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([timestamp])
  @@index([userId], map: "system_logs_user_id_fkey")
  @@map("system_logs")
}

model Report {
  id            String         @id @default(uuid()) @db.Char(36)
  caseId        String         @map("case_id") @db.Char(36)
  generatedBy   String         @map("generated_by") @db.Char(36)
  reportData    String         @map("report_data") @db.LongText
  createdAt     DateTime       @default(now()) @map("created_at")
  reportExports ReportExport[]
  case          Case           @relation(fields: [caseId], references: [id])
  user          User           @relation(fields: [generatedBy], references: [id])

  @@index([caseId], map: "reports_case_id_fkey")
  @@index([generatedBy], map: "reports_generated_by_fkey")
  @@map("reports")
}

model ReportExport {
  id           String   @id @default(uuid()) @db.Char(36)
  reportId     String   @map("report_id") @db.Char(36)
  exportedBy   String   @map("exported_by") @db.Char(36)
  exportFormat String   @map("export_format") @db.VarChar(10)
  exportedAt   DateTime @map("exported_at")
  user         User     @relation(fields: [exportedBy], references: [id])
  report       Report   @relation(fields: [reportId], references: [id])

  @@index([exportedBy], map: "report_exports_exported_by_fkey")
  @@index([reportId], map: "report_exports_report_id_fkey")
  @@map("report_exports")
}

model CourtPresentation {
  id            String    @id @default(uuid()) @db.Char(36)
  evidenceId    String    @map("evidence_id") @db.Char(36)
  courtName     String    @map("court_name") @db.VarChar(200)
  exhibitNumber String    @map("exhibit_number") @db.VarChar(100)
  presentedDate DateTime  @map("presented_date")
  returnedDate  DateTime? @map("returned_date")
  presentedBy   String    @map("presented_by") @db.Char(36)
  returnedBy    String?   @map("returned_by") @db.Char(36)

  evidence      Evidence  @relation(fields: [evidenceId], references: [id])
  presenter     User      @relation("PresentedBy", fields: [presentedBy], references: [id])
  returner      User?     @relation("ReturnedBy", fields: [returnedBy], references: [id])

  @@index([evidenceId])
  @@index([presentedBy])
  @@index([returnedBy])
  @@map("court_presentations")
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  PENDING_REVIEW
  REFERRED
  SUSPENDED
  COLD
  ON_HOLD
  SUBMITTED_TO_PROSECUTION
  IN_COURT
  ARCHIVED
}

enum EvidenceCategory {
  PHYSICAL
  DIGITAL
  BIOLOGICAL
  DOCUMENT
  OTHER
}

enum EvidenceStatus {
  SEIZED
  IN_TRANSIT
  IN_STORAGE
  AT_LAB
  IN_COURT
  RETURNED
  DESTROYED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalActionType {
  EDIT
  SOFT_DELETE
}

enum CustodyAction {
  CREATE
  VIEW
  HANDOVER_DISPATCH
  HANDOVER_ACK
  VERIFY
  COLLECTED
  TRANSFERRED
  RECEIVED
  LAB_ANALYSIS
  COURT_SUBMISSION
  RETURNED
  EXTERNAL_TRANSFER
  OTHER
}
